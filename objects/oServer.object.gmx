      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>banList = ds_list_create();
kickList = ds_list_create();
randomize();
strict_init("dictionary.json");
canChange = true;
var type;
type = network_socket_tcp;
if(!file_exists(working_directory + "\settings.ini")){
    ini_open(working_directory + "\settings.ini");
    ini_write_real("Settings", "port", 64198);
    ini_write_real("Settings", "maxplayers", 16);
    ini_write_string("Settings", "moderatorpass", string(random_get_seed()));
    ini_close();
}
ini_open(working_directory + "\settings.ini");
port = ini_read_real("Settings", "port", 64198);
maxClients = ini_read_real("Settings", "maxplayers", 16);
password = ini_read_string("Settings", "moderatorpass", string(random_get_seed()));
// NAT traversal settings
var nat_enabled_str = ini_read_string("Settings", "use_nat_traversal", "disabled");
use_nat_traversal = (nat_enabled_str == "enabled");
mediation_server_ip = ini_read_string("Settings", "mediation_server", "127.0.0.1");
mediation_server_port = ini_read_real("Settings", "mediation_port", "6510");
ini_close();
show_debug_message("NAT settings: enabled=" + nat_enabled_str + " server=" + mediation_server_ip + ":" + string(mediation_server_port));

// Initialize NAT constants
nat_constants();

if(!file_exists(working_directory + "\blacklist.txt")){
    blacklist = file_text_open_write(working_directory + "\blacklist.txt");
    file_text_close(blacklist);
} else {
    ds_list_clear(banList);
    blacklist = file_text_open_read(working_directory + "\blacklist.txt");
    while(!file_text_eof(blacklist)){
        ds_list_add(banList, file_text_read_string(blacklist));
        file_text_readln(blacklist)
    }
}

if(maxClients &gt; 16){
    maxClients = 16;
}

// UDP Proxy Setup - Use configured port for UDP, random port for internal TCP
udp_socket = network_create_socket_ext(network_socket_udp, port);
show_debug_message("Server: Created UDP socket " + string(udp_socket) + " on port " + string(port));

// Create internal TCP server on random available port
tcp_internal_port = irandom_range(50000, 60000);
server = network_create_server(type, tcp_internal_port, maxClients);

show_debug_message("Server: Created TCP server socket " + string(server) + " on port " + string(tcp_internal_port));

// UDP proxy data structures
udp_clients = ds_map_create();  // "ip:port" -&gt; client state map
tcp_to_udp = ds_map_create();   // TCP socket -&gt; "ip:port"
udp_forward_buffer = buffer_create(65536, buffer_grow, 1);
UDP_CLIENT_TIMEOUT = 30000;
tcp_server_ip = "127.0.0.1";

// UDP fragmentation settings
UDP_MAX_FRAGMENT_SIZE = 1200;  // Conservative size for remote networks (avoids IP fragmentation)
next_fragment_id = 0;  // Global fragment ID counter

// Reliable UDP with ACK/retransmission
next_sequence_number = 0;  // Global sequence number for reliable packets
RETRANSMIT_TIMEOUT = 200;  // Milliseconds before retransmitting
MAX_RETRANSMITS = 5;  // Maximum retransmission attempts

// TCP client activity tracking for direct connections
tcp_client_activity = ds_map_create();  // TCP socket -&gt; last_activity_time
TCP_CLIENT_TIMEOUT = 10000;  // 10 seconds for game clients

show_debug_message("Server: UDP proxy ready - clients connect to port " + string(port));
show_debug_message("Server: Internal proxy will forward to " + tcp_server_ip + ":" + string(tcp_internal_port));

// Initialize NAT traversal for server
if (use_nat_traversal) {
    nat_init_server();
    nat_connect_mediation_server();
    nat_keepalive_timer = 0;
    NAT_KEEPALIVE_INTERVAL = 300;  // Send keepalive every 300 steps (~5 seconds at 60fps)
} else {
    // Initialize to safe defaults so cleanup doesn't error
    nat_client_tunnels = -1;
    mediation_socket = -1;
    mediation_connected = false;
    nat_state = 0;
    nat_type = 0;
}

var _port = 64199;
webpanel = network_create_server_raw(type, _port, 2);

var size, type, alignment;
size = 1024;
type = buffer_grow;
alignment = 1;
buffer = buffer_create(size, type, alignment);

socketList = ds_list_create();
playerList = ds_list_create();
idList = ds_list_create();
timeList = ds_list_create();
resetList = ds_list_create();
samusList = ds_list_create();
saxList = ds_list_create();
deadList = ds_list_create();

vars = ds_grid_create(3, 20);
map = ds_map_create();
posMap = ds_map_create();

var import = json_import("item_dict.json");
dict = json_decode(import);

queenHealth = 600;
queenPhase = 0;
queenState = 0;

prevPlayerListSize = ds_list_size(playerList);

alarm[0] = 90;
alarm[1] = 90;
alarm[2] = 300;
alarm[3] = 360;
alarm[4] = 420;
alarm[5] = 3600;
alarm[9] = 60;
alarm[10] = 600;
alarm[11] = 60;

reset_globals();

global.slot = 1;

var slotStr = string(global.slot);

global.saveString = "\save" + slotStr + ".txt";

syncedDifficulty = 1;
syncedELM = 0;
posMapModified = false;

global.lobbyLocked = false;

global.damageMult = 0;

global.clientVersion = "V1.4.2";

global.experimental = false;
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="1" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>buffer_delete(buffer);
var size, type, alignment;
size = 1024;
type = buffer_grow;
alignment = 1;
buffer = buffer_create(size, type, alignment);
buffer_seek(buffer, buffer_seek_start, 0);
buffer_write(buffer, buffer_u8, 107);
var bufferSize = buffer_tell(buffer);
buffer_seek(buffer, buffer_seek_start, 0);
buffer_write(buffer, buffer_s32, bufferSize);
buffer_write(buffer, buffer_u8, 107);

var sockets = ds_list_size(playerList);
for(var i=0; i&lt;sockets; i++){
    network_send_packet(playerList[| i], buffer, buffer_tell(buffer));
}

network_destroy(server);
network_destroy(webpanel);
if(buffer_exists(buffer)){
    buffer_delete(buffer);
}

// Clean up UDP proxy resources
var key = ds_map_find_first(udp_clients);
while (!is_undefined(key)) {
    var client_state = ds_map_find_value(udp_clients, key);
    var tcp_socket = ds_map_find_value(client_state, "tcp_socket");
    if (tcp_socket != noone) {
        network_destroy(tcp_socket);
    }
    var recv_buffer = ds_map_find_value(client_state, "recv_buffer");
    if (buffer_exists(recv_buffer)) {
        buffer_delete(recv_buffer);
    }
    
    // Clean up pending packets if any
    if (ds_map_exists(client_state, "pending_packets")) {
        var pending_list = ds_map_find_value(client_state, "pending_packets");
        var packet_count = ds_list_size(pending_list) / 2;
        for (var i = 0; i &lt; packet_count; i++) {
            var pending_buffer = pending_list[| i * 2];
            buffer_delete(pending_buffer);
        }
        ds_list_destroy(pending_list);
    }
    
    ds_map_destroy(client_state);
    key = ds_map_find_next(udp_clients, key);
}
ds_map_destroy(udp_clients);
ds_map_destroy(tcp_to_udp);
network_destroy(udp_socket);
buffer_delete(udp_forward_buffer);
ds_map_destroy(tcp_client_activity);

// Clean up NAT traversal
if (use_nat_traversal) {
    nat_cleanup_server();
}

ds_list_destroy(socketList);
ds_list_destroy(playerList);
ds_list_destroy(idList);
ds_list_destroy(timeList);
ds_list_destroy(resetList);
ds_list_destroy(banList);
ds_list_destroy(kickList);
ds_list_destroy(samusList);
ds_list_destroy(saxList);
ds_list_destroy(deadList);
ds_grid_destroy(vars);
ds_map_destroy(map);
ds_map_destroy(posMap);
</string>
