                buffer_write(buffer, buffer_s8, sax);
                var sockets = ds_list_size(playerList);
                for(var i=0; i&lt;sockets; i++){
                    if(playerList[| i] != socket) network_send_packet(playerList[| i], buffer, buffer_tell(buffer));
                }
                break;
            case 50:
                if(bufferSize &lt; 350) exit;
                show_debug_message("item");
                var sockets = ds_list_size(playerList);
                for(var v=0; v&lt;sockets; v++){
                    for(var g=0; g&lt;ds_list_size(idList); g++){
                        var arr = idList[| g];
                        var arrID = arr[0, 0];
                        var arrSocket = arr[0, 1];
                        if(arrSocket == playerList[| v] &amp;&amp; playerList[| v] == socket){
                            var findID = ds_list_find_index(samusList, arrID);
                            if(findID &gt;= 0 &amp;&amp; team = 1){
                                for(var i=0; i&lt;array_length_1d(global.itemSamus); i++){
                                    var receivedItem = buffer_read(_buffer, buffer_u8);
                                    if(receivedItem == 1 &amp;&amp; global.itemSamus[i] == 0){
                                        global.itemSamus[i] = receivedItem;
                                    }
                                }
                            }
                            
                            var findID = ds_list_find_index(saxList, arrID);
                            if(findID &gt;= 0 &amp;&amp; team = 2){
                                for(var i=0; i&lt;array_length_1d(global.itemSAX); i++){
                                    var receivedItem = buffer_read(_buffer, buffer_u8);
                                    if(receivedItem == 1 &amp;&amp; global.itemSAX[i] == 0){
                                        global.itemSAX[i] = receivedItem;
                                    }
                                }
                            }
                        }
                    }
                }
                alarm[2] = 30;
                break;
            case 51:
                if(bufferSize &lt; 400) exit;
                show_debug_message("event");
                for(var i=0; i&lt;array_length_1d(global.event); i++){
                    if(i &lt; 350){
                        var receivedEvent = buffer_read(_buffer, buffer_u8);
                        if(floor(receivedEvent) &gt; floor(global.event[i])){
                            global.event[i] = receivedEvent;
                        }
                    }
                }
                alarm[2] = 30;
                break;
            case 52:
                if(bufferSize &lt; 100) exit;
                show_debug_message("metdead");
                for(var i=0; i&lt;array_length_1d(global.metdead); i++){
                    var receivedMetdead = buffer_read(_buffer, buffer_u8);
                    if(receivedMetdead &gt; global.metdead[i]){
                        global.metdead[i] = receivedMetdead;
                    }
                }
                alarm[2] = 30;
                break;
            case 53:
                if(bufferSize &lt; 6400) exit;
                show_debug_message("dmap");
                var sockets = ds_list_size(playerList);
                for(var v=0; v&lt;sockets; v++){
                    for(var g=0; g&lt;ds_list_size(idList); g++){
                        var arr = idList[| g];
                        var arrID = arr[0, 0];
                        var arrSocket = arr[0, 1];
                        if(arrSocket == playerList[| v] &amp;&amp; playerList[| v] == socket){
                            var findID = ds_list_find_index(samusList, arrID);
                            if(findID &gt;= 0 &amp;&amp; team = 1){
                                for(var i=0; i&lt;array_height_2d(global.dmapSamus); i++){
                                    for(var j=0; j&lt;array_length_2d(global.dmapSamus, i); j++){
                                        var receiveddmap = buffer_read(_buffer, buffer_u8);
                                        if(receiveddmap &gt; global.dmapSamus[i, j]){
                                            global.dmapSamus[i, j] = receiveddmap;
                                        } else if(receiveddmap == 1 &amp;&amp; global.dmapSamus[i, j]){
                                            global.dmapSamus[i, j] = receiveddmap;
                                        }
                                    }
                                }
                            }
                            
                            var findID = ds_list_find_index(saxList, arrID);
                            if(findID &gt;= 0 &amp;&amp; team = 2){
                                for(var i=0; i&lt;array_height_2d(global.dmapSAX); i++){
                                    for(var j=0; j&lt;array_length_2d(global.dmapSAX, i); j++){
                                        var receiveddmap = buffer_read(_buffer, buffer_u8);
                                        if(receiveddmap &gt; global.dmapSAX[i, j]){
                                            global.dmapSAX[i, j] = receiveddmap;
                                        } else if(receiveddmap == 1 &amp;&amp; global.dmapSAX[i, j]){
                                            global.dmapSAX[i, j] = receiveddmap;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                alarm[5] = 30;
                break;
    }
}

if(ds_map_exists(posMap, banSocket) &amp;&amp; !posMapModified){
    var list = ds_map_find_value(posMap, banSocket);
    if(ds_list_size(list) &gt; 0){
        var arr = list[| ds_list_size(list) - 1];
        arr[0] = current_time;
        ds_list_add(list, arr);
        if(ds_list_size(list) &gt; 180) ds_list_delete(list, 0);
        ds_map_replace(posMap, banSocket, list);
        //show_debug_message(list[| ds_list_size(list) - 1])
    }
}

posMapModified = false;
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="7" enumb="14">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>var saxCountMax = 0;
var saxCount = 0;
var sockets = ds_list_size(playerList);
newTeamList = ds_list_create();
if(sockets &gt; 2){
    saxCountMax = round(sockets / 2);
    if(saxCountMax &gt; sockets / 2) saxCountMax--;
    for(var i=0; i&lt;sockets; i++){
        if(saxCount &lt; saxCountMax){
            newTeamList[| i] = 2;
            saxCount++;
        } else newTeamList[| i] = 1;
    }
    ds_list_shuffle(newTeamList);
} else if(sockets == 2){
    newTeamList[| 0] = 1;
    newTeamList[| 1] = 2;
    ds_list_shuffle(newTeamList);
}

for(var i=0; i&lt;sockets; i++){
    var newTeam = 0;
    if(sockets &gt;= 2) newTeam = newTeamList[| i];
    if(!global.saxmode) newTeam = 1;
    buffer_delete(buffer);
    var size, type, alignment;
    size = 1024;
    type = buffer_grow;
    alignment = 1;
    buffer = buffer_create(size, type, alignment);
    buffer_seek(buffer, buffer_seek_start, 0);
    buffer_write(buffer, buffer_u8, 112);
    buffer_write(buffer, buffer_u8, global.saxmode);
    buffer_write(buffer, buffer_u8, newTeam);
    var bufferSize = buffer_tell(buffer);
    buffer_seek(buffer, buffer_seek_start, 0);
    buffer_write(buffer, buffer_s32, bufferSize);
    buffer_write(buffer, buffer_u8, 112);
    buffer_write(buffer, buffer_u8, global.saxmode);
    buffer_write(buffer, buffer_u8, newTeam);
    network_send_packet(playerList[| i], buffer, buffer_tell(buffer));
    
    for(var f=0; f&lt;ds_list_size(idList); f++){
        var arrList = idList[| f];
        if(arrList[0, 1] == playerList[| i]){
            if(newTeam == 1){
                var findIDSAX = ds_list_find_index(saxList, arrList[0, 0]);
                if(findIDSAX &gt;= 0){
                    ds_list_delete(saxList, findIDSAX);
                    ds_list_add(samusList, arrList[0, 0]);
                    break;
                }
            }
            
            if(newTeam == 2){
                var findIDSamus = ds_list_find_index(samusList, arrList[0, 0]);
                if(findIDSamus &gt;= 0){
                    ds_list_delete(samusList, findIDSamus);
                    ds_list_add(saxList, arrList[0, 0]);
                    break;
                } 
            }
        }
    }
}

ds_list_destroy(newTeamList);
</string>
          </argument>
        </arguments>
      </action>
    </event>
